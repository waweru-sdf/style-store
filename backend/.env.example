# Copy to .env (never commit .env)

# Leave empty to run in MOCK payment mode (demo without a Paystack account).
# Set a TEST secret key (sk_test_...) to use real Paystack test checkout.
PAYSTACK_SECRET_KEY=

# Where the React app runs (used for Paystack callback + CORS)
FRONTEND_URL=http://localhost:5173

# Protects /api/admin/*. Leave empty to disable admin endpoints.
ADMIN_TOKEN=change-me-to-a-long-random-string

PORT=5000
